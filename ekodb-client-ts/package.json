{
  "name": "@ekodb/ekodb-client",
  "version": "0.31.1",
  "description": "Official TypeScript/JavaScript client for ekoDB",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./dist": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ekodb",
    "database",
    "client",
    "typescript"
  ],
  "author": "ekoDB",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ws": "^8.20.1"
  }
}
